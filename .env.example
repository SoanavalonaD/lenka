# ==============================================================================
# CONFIGURATION DES VARIABLES D'ENVIRONNEMENT (SUPABASE / POSTGRESQL)
# ==============================================================================

# 1. URL DE CONNEXION POSTGRESQL SUPABASE :
# Récupérable dans votre tableau de bord Supabase :
# Project Settings > Database > Connection string > URI (ou Node.js)
#
# Format Connection Pooling (Recommandé pour Next.js, Port 6543) :
# DATABASE_URL="postgresql://postgres.[VOTRE_PROJECT_REF]:[VOTRE_MOT_DE_PASSE]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
#
# Format Connexion Directe (Port 5432) :
# DATABASE_URL="postgresql://postgres:[VOTRE_MOT_DE_PASSE]@db.[VOTRE_PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
#
# Note : Si DATABASE_URL est laissée vide, le projet fonctionne automatiquement
# en local avec son moteur PostgreSQL embarqué (PGlite).
DATABASE_URL=""

# 2. URL DU SITE (pour métadonnées SEO et partage réseaux sociaux)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

